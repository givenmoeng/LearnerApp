{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'assessor')",

        ".write": "auth != null && auth.uid === $uid",

        ".validate": "newData.hasChildren(['name', 'email', 'role']) && ((!data.exists() && newData.child('role').val() === 'learner') || (data.exists() && newData.child('role').val() === data.child('role').val()))",

        "name": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 100"
        },

        "email": {
          ".validate": "newData.isString() && newData.val().length <= 150"
        },

        "role": {
          ".validate": "newData.val() === 'learner' || newData.val() === 'assessor'"
        }
      }
    },

    "tasks": {
      "$taskId": {
        ".read": "auth != null && (data.child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'assessor')",

        ".write": "auth != null && data.child('userId').val() === auth.uid",

        ".validate": "newData.hasChildren(['userId', 'title', 'description', 'category', 'priority', 'dueDate', 'status']) && newData.child('userId').val() === auth.uid",

        "userId": {
          ".validate": "newData.val() === auth.uid"
        },

        "title": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 150"
        },

        "description": {
          ".validate": "newData.isString() && newData.val().length <= 1000"
        },

        "category": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },

        "priority": {
          ".validate": "newData.val() === 'Low' || newData.val() === 'Medium' || newData.val() === 'High'"
        },

        "status": {
          ".validate": "newData.val() === 'Pending' || newData.val() === 'In Progress' || newData.val() === 'Completed'"
        },

        "dueDate": {
          ".validate": "newData.isString()"
        }
      }
    },

    "bookings": {
      "$bookingId": {
        ".read": "auth != null && (data.child('learnerId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'assessor')",

        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'assessor' || (!data.exists() && newData.child('learnerId').val() === auth.uid) || (data.child('learnerId').val() === auth.uid && newData.child('learnerId').val() === auth.uid && newData.child('status').val() === data.child('status').val()))",

        ".validate": "newData.hasChildren(['learnerId', 'topic', 'date', 'time', 'status'])",

        "learnerId": {
          ".validate": "newData.val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'assessor'"
        },

        "topic": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 150"
        },

        "date": {
          ".validate": "newData.isString()"
        },

        "time": {
          ".validate": "newData.isString()"
        },

        "status": {
          ".validate": "newData.val() === 'Pending' || newData.val() === 'Approved' || newData.val() === 'Completed' || newData.val() === 'Cancelled'"
        }
      }
    },

    "resources": {
      "$resourceId": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'assessor'",

        ".validate": "newData.hasChildren(['title', 'type', 'description', 'category', 'createdBy'])",

        "title": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 150"
        },

        "type": {
          ".validate": "newData.val() === 'Document' || newData.val() === 'Link' || newData.val() === 'Guide' || newData.val() === 'Video'"
        },

        "description": {
          ".validate": "newData.isString() && newData.val().length <= 1000"
        },

        "category": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },

        "createdBy": {
          ".validate": "newData.val() === auth.uid"
        },

        "url": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 1000)"
        }
      }
    },

    "gameScores": {
      "$scoreId": {
        ".read": "auth != null && (data.child('learnerId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'assessor')",

        ".write": "auth != null && (!data.exists() && newData.child('learnerId').val() === auth.uid)",

        ".validate": "newData.hasChildren(['learnerId', 'score', 'game', 'createdAt'])",

        "learnerId": {
          ".validate": "newData.val() === auth.uid"
        },

        "score": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },

        "game": {
          ".validate": "newData.isString() && newData.val().length <= 150"
        }
      }
    }
  }
}